	<subDataset name="Dataset1" uuid="2874a71c-5001-48ea-a7b6-bf262198284b">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Baxter"/>
		<property name="net.sf.jasperreports.filters" value="[]"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="238"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="757"/>
		<parameter name="USER_ID" class="java.lang.Integer" isForPrompting="false"/>
		<parameter name="SITE_ID" class="java.lang.Long" isForPrompting="false"/>
		<parameter name="RoleName" class="java.util.Collection"/>
		<parameter name="User" class="java.util.Collection"/>
		<parameter name="SqlFilterRole" class="java.lang.String">
			<defaultValueExpression><![CDATA[($P{RoleName}!=null && !$P{RoleName}.isEmpty()) ? " AND ISNULL(ABS(sud.[$$RoleLevel$$]), 1) IN (" + String.join(",", $P{RoleName}) + ")" : " "]]></defaultValueExpression>
		</parameter>
		<parameter name="SqlFilterUser" class="java.lang.String">
			<defaultValueExpression><![CDATA[($P{User}!=null && !$P{User}.isEmpty())? " AND sud.UserId IN (" + String.join(",", $P{User}) + ")" : " "]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT 
	[SiteName] AS [Room Name]
	,[$$InvitedOn$$] AS [Invited On]
	,sud.[FullName] AS [User Full Name]
	,[UserId] AS [UserId]
	,[UserName] AS [User Email Address]
	,[$$InvitedBy$$] AS [Invited By]
	,[$$OrganizationName$$] AS [Organization]
	,[$$ResponsibleDepartments$$] AS [Department Name]
	,ISNULL([$$RoleName$$], 'No Access') AS [Current Access Level]
	,[$$Status$$] AS [Status]
	,[$$Actions$$] AS [Actions]
	,[$$Groups$$] AS [Groups]
	,[$$ExpirationDate$$] AS [Expiration Date]
	,[$$InvitationMode$$] AS [Invitation Mode]
	,[$$LastVisit$$] AS [Last Visit Date]
	,[$$LastLoginDate$$] AS [Last Login Date]
	,[$$AccessRevokedOn$$] AS [Access Revoked On]
	,[$$AccessRevokedBy$$] AS [Access Revoked By]
	,[$$IsDeleted$$] AS [Is Deleted]
	,[$$IsExpired$$] AS [Is Expired]
	,[$$PrevRoleName$$] AS [Previous User Role]
	,[$$RoleUpdateDate$$] AS [Date the last role was changed]
FROM [dbo].[vw_SiteUserData] sud
WHERE ISNULL(sud.[$$RoleLevel$$], 1) BETWEEN -499 AND 499
	AND sud.SiteTypeId = 1 
	AND sud.[$$Status$$] = 'Active'
	$P!{SqlFilterUser}
	$P!{SqlFilterRole}]]>
		</queryString>
		<field name="Room Name" class="java.lang.String"/>
		<field name="Invited On" class="java.sql.Timestamp"/>
		<field name="User Full Name" class="java.lang.String"/>
		<field name="User Email Address" class="java.lang.String"/>
		<field name="Invited By" class="java.lang.String"/>
		<field name="Organization" class="java.lang.String"/>
		<field name="$$ResponsibleDepartments$$" class="java.lang.String"/>
		<field name="Current Access Level" class="java.lang.String"/>
		<field name="Actions" class="java.lang.String"/>
		<field name="Groups" class="java.lang.String"/>
		<field name="Expiration Date" class="java.sql.Timestamp"/>
		<field name="Invitation Mode" class="java.lang.String"/>
		<field name="Last Visit Date" class="java.sql.Timestamp"/>
		<field name="Last Login Date" class="java.sql.Timestamp"/>
		<field name="Access Revoked On" class="java.sql.Timestamp"/>
		<field name="Access Revoked By" class="java.lang.String"/>
		<field name="Is Deleted" class="java.lang.Boolean"/>
		<field name="Is Expired" class="java.lang.Boolean"/>
		<field name="UserId" class="java.lang.Integer"/>
		<field name="Previous User Role" class="java.lang.String"/>
		<field name="Previous User Level" class="java.lang.String"/>
		<field name="Date the last role was changed" class="java.sql.Timestamp"/>
		<field name="ResponsibleDepartments" class="java.lang.String"/>
		<sortField name="User Full Name"/>
	</subDataset>

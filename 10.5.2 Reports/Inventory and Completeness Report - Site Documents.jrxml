		<parameter name="SiteIds" class="java.util.Collection"/>
		<parameter name="ArtifactNumberRegex" class="java.lang.String">
			<defaultValueExpression><![CDATA["(\\d{2}.\\d{2}.\\d{2})(.*)"]]></defaultValueExpression>
		</parameter>
		<parameter name="SQLFilter" class="java.lang.String">
			<defaultValueExpression><![CDATA["[CodingTypeId] = 2 AND [$$ParentIndexFolder$$] <> (''*Inbox'') AND [$$IndexFolder$$] NOT IN (''Staging'', ''Rejected Documents'') AND [$$CompletenessStatus$$] IN (''" + String.join("'',''",$P{Status} ) + "'') AND [InvestigativeSiteId] IN (''" + String.join("'',''",$P{SiteIds} ) + "'')"]]></defaultValueExpression>
		</parameter>
		<queryString language="SQL">
			<![CDATA[exec dbo.Reports_Metadata_Dynamic2
			@SiteId = $P{SITE_ID},
			@UserId = $P{USER_ID},
@ReturnMissingDocuments =1,
@WorkingDocumentsIndex = 0,
@ShowNotApplicablePlaceholders = 1,
@CodingTypeId= 2,
@SQLFilter = N'$P!{SQLFilter}', 
@RestrictedFolders = N'-1,-2 -3, -4, -5',
@ListOfUsedColumns=N'[$$ParentIndexFolder$$],[$$SecondParentIndexFolder$$], [$$IndexFolder$$], [$$Country$$], [$$InvestigativeSiteName$$], [$$PrincipalInvestigator$$], [$$ContactName$$], [$$DocumentTypeName$$],[Document Id],[DocumentName],[Original Title], [$$SubmittedOn$$], [$$AddedBy$$],[$$SubmitterOrganization$$], [Document Date], [Expiration Date],[PublishedDate],[$$DocumentStatusName$$], [$$Required$$], [$$CompletenessStatus$$],[Comments], [NotApplicableReason], [$$EventName$$], [$$EventTypeName$$], [$$CompletedDate$$], [$$EventPlanedDate$$], [$$EventDueDate$$], [$$ResponsibleDepartment$$], [Document Link]',
@ReturnedColumns=N'[$$ParentIndexFolder$$],[$$SecondParentIndexFolder$$], [$$IndexFolder$$], [$$Country$$], [$$InvestigativeSiteName$$], [$$PrincipalInvestigator$$], [$$ContactName$$], [$$DocumentTypeName$$],[Document Id],[DocumentName],[Original Title], [$$SubmittedOn$$], [$$AddedBy$$],[$$SubmitterOrganization$$], [Document Date], [Expiration Date],[PublishedDate],[$$DocumentStatusName$$], [$$Required$$], [$$CompletenessStatus$$],[Comments], [NotApplicableReason], [$$EventName$$], [$$EventTypeName$$], [$$CompletedDate$$], [$$EventPlanedDate$$], [$$EventDueDate$$], [$$ResponsibleDepartment$$], [Document Link]']]>
		</queryString>

			<variableExpression><![CDATA[$F{$$ParentIndexFolder$$}.replace($F{$$ParentIndexFolder$$}.replaceFirst("^\\d.*\\d",""),"").trim()]]></variableExpression>
		</variable>
		<variable name="SectionName" class="java.lang.String">
			<variableExpression><![CDATA[$F{$$ParentIndexFolder$$}.replaceFirst("^\\d.*\\d","").trim()]]></variableExpression>
		</variable>
		<variable name="ArtifactNumber" class="java.lang.String">
			<variableExpression><![CDATA[$F{$$IndexFolder$$}.matches($P{ArtifactNumberRegex}) ? $F{$$IndexFolder$$}.replaceAll($P{ArtifactNumberRegex},"$1").trim() : ""]]></variableExpression>
		</variable>
		<variable name="ArtifactName" class="java.lang.String">
			<variableExpression><![CDATA[$F{$$IndexFolder$$}.matches($P{ArtifactNumberRegex}) ? $F{$$IndexFolder$$}.replaceAll($P{ArtifactNumberRegex},"$2").trim() : $F{$$IndexFolder$$}]]></variableExpression>
		</variable>
		<variable name="ZoneNumber" class="java.lang.String">

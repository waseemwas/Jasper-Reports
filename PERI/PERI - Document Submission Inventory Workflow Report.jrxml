	<subDataset name="Dataset1" uuid="45f2dc73-9355-48b6-9af7-2a3b14658908">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="1"/>
		<parameter name="USER_ID" class="java.lang.Integer" isForPrompting="false">
			<parameterDescription><![CDATA[]]></parameterDescription>
			<defaultValueExpression><![CDATA[2]]></defaultValueExpression>
		</parameter>
		<parameter name="SITE_ID" class="java.lang.Long" isForPrompting="false">
			<defaultValueExpression><![CDATA[222L]]></defaultValueExpression>
		</parameter>
		<queryString language="SQL">
			<![CDATA[SELECT 
    dpd.[SiteId] AS [Study Room Id],
    dpd.[$$RoomName$$] AS [Study Room Name],
    dpd.[$$AddedBy$$] AS [Submitter],
    sud.[$$OrganizationName$$] AS [Submitter's Organization],
    dpd.[SubmittedOn] AS [Submission Date],
    dpd.[$$CategoryName$$] AS [Category],
    dpd.[$AutoSiteName$] AS [Site],
    dpd.[Title] AS [Title],
    dpd.[$$DocumentTypeName$$] AS [Document Type],
    dpd.[TopicId] AS [Document ID],
    dpd.[Document Date] AS [Document Date],
    wl.[QC1ClaimDate] AS [Workflow First Claim],
    dpd.CurrentWorkflow AS [Workflow Name],
    wl.[QC1ApprovedDate] AS [Approved Date],
    dpd.[Sender Name] AS [Sender Name],
    dpd.[Document URL] AS [Document Link]
    
 FROM dbo.vw_DocsProfileData dpd
LEFT JOIN dbo.vw_SiteUserData sud ON dpd.SiteId = sud.SiteId AND dpd.AddedById = sud.UserId
INNER JOIN dbo.SiteMetadata sm ON dpd.SiteId = sm.SiteId
INNER JOIN dbo.WorkflowLog wl ON dpd.TopicId = wl.DocumentId 
WHERE  sm.SponsorId = '10092778'
ORDER BY dpd.SiteId ASC;]]>
		</queryString>
		<field name="Study Room Id" class="java.lang.Integer"/>
		<field name="Study Room Name" class="java.lang.String"/>
		<field name="Submitter" class="java.lang.String"/>
		<field name="Submitter&apos;s Organization" class="java.lang.String"/>
		<field name="Submission Date" class="java.sql.Timestamp"/>
		<field name="Category" class="java.lang.String"/>
		<field name="Site" class="java.lang.String"/>
		<field name="Title" class="java.lang.String"/>
		<field name="Document Type" class="java.lang.String"/>
		<field name="Document ID" class="java.lang.Integer"/>
		<field name="Document Date" class="java.sql.Timestamp"/>
		<field name="Workflow First Claim" class="java.sql.Timestamp"/>
		<field name="Workflow Name" class="java.lang.String"/>
		<field name="Approved Date" class="java.sql.Timestamp"/>
		<field name="Sender Name" class="java.lang.String"/>
		<field name="Document Link" class="java.lang.String"/>
	</subDataset>

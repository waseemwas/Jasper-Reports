			<variableExpression><![CDATA[$F{DocsPassed} == 0 || $F{DocsReviewed} == 0 ? "" : msg("{0,number,##0.0%}", new Float($F{DocsPassed}.floatValue() / $F{DocsReviewed}.floatValue()))]]></variableExpression>

	<subDataset name="Dataset1" uuid="2874a71c-5001-48ea-a7b6-bf262198284b">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Baxter"/>
		<parameter name="USER_ID" class="java.lang.Integer" isForPrompting="false"/>
		<parameter name="SITE_ID" class="java.lang.Long" isForPrompting="false"/>
		<queryString>
			<![CDATA[exec Reports_UserList
						@SiteId=$P{SITE_ID},
						@UserId= $P{USER_ID},
						@SQLFilter=N'[DaysInactive] > 119 AND ([RoleLevel] <> 1 OR [RoleLevel] IS NULL) AND ([RoleName] <> ''SuperAdministrator'' OR [RoleName] IS NULL) ']]>
		</queryString>
		<field name="RoomId" class="java.lang.Integer"/>
		<field name="RoomName" class="java.lang.String"/>
		<field name="UserId" class="java.lang.Integer"/>
		<field name="UserName" class="java.lang.String"/>
		<field name="FullName" class="java.lang.String"/>
		<field name="InvitedOn" class="java.sql.Timestamp"/>
		<field name="InvitedById" class="java.lang.Integer"/>
		<field name="InvitedBy" class="java.lang.String"/>
		<field name="OrganizationId" class="java.lang.Integer"/>
		<field name="OrganizationName" class="java.lang.String"/>
		<field name="InvitationMode" class="java.lang.String"/>
		<field name="LastVisit" class="java.sql.Timestamp"/>
		<field name="RoleLevel" class="java.lang.Integer"/>
		<field name="RoleName" class="java.lang.String"/>
		<field name="IsDeleted" class="java.lang.Boolean"/>
		<field name="IsExpired" class="java.lang.Boolean"/>
		<field name="AccessRevokedOn" class="java.sql.Timestamp"/>
		<field name="AccessRevokedBy" class="java.lang.String"/>
		<field name="DaysInactive" class="java.lang.Integer"/>
		<field name="ExpirationDate" class="java.sql.Timestamp"/>
		<field name="TotalLoginCount" class="java.lang.Integer"/>
		<sortField name="DaysInactive"/>
	</subDataset>

	<subDataset name="Dataset1" uuid="2874a71c-5001-48ea-a7b6-bf262198284b">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<parameter name="USER_ID" class="java.lang.Integer" isForPrompting="false"/>
		<parameter name="SITE_ID" class="java.lang.Long" isForPrompting="false"/>
		<queryString>
			<![CDATA[SELECT
SiteName,
SitesData.SiteId,
ProjectCode,
NumberOfDocs,
TMFApplicable,
TMFApplicableNO,
(TMFApplicable + TMFApplicableNO) AS TMFApplicableSet,
TMFApplicableNotSet,
TMFApplicableNotSetOver30Days,
copiedToTMF,
TMFApplicableNotPublished,
TMFApplicableNotPublishedOver30,
TMFApplicablePublished,
TMFNotApplicablePublished,
OpenRoomURL
FROM (
SELECT
s.SiteName,
s.SiteId,
sm.ProjectCode,
COUNT(*)
NumberOfDocs,
SUM(
CASE WHEN dm.TMFApplicable = 1 OR (dm.[$CopiedToLinkedRoomsDate$] IS NOT NULL) THEN 1
ELSE 0 END) AS TMFApplicable,
SUM(
CASE WHEN dm.TMFApplicable = 0 AND (dm.[$CopiedToLinkedRoomsDate$] IS NULL) THEN 1
ELSE 0 END) AS TMFApplicableNO,
SUM(CASE WHEN dm.TMFApplicable IS NULL AND (dm.[$CopiedToLinkedRoomsDate$] IS NULL) THEN 1
ELSE 0 END) AS TMFApplicableNotSet,
SUM(CASE WHEN dm.TMFApplicable IS NULL AND (dm.[$CopiedToLinkedRoomsDate$] IS NULL) AND DATEDIFF(DAY, dmv.SubmittedOn, GETDATE()) > 30 THEN 1
ELSE 0 END) AS TMFApplicableNotSetOver30Days,
SUM (CASE WHEN dm.[$CopiedToLinkedRoomsDate$] IS NOT NULL THEN 1 ELSE 0 END) copiedToTMF,
SUM(
CASE WHEN dm.TMFApplicable = 1 AND dm.[$CopiedToLinkedRoomsDate$] IS NULL THEN 1
ELSE 0 END) AS TMFApplicableNotPublished,
SUM(
CASE WHEN dm.TMFApplicable = 1 AND dm.[$CopiedToLinkedRoomsDate$] IS NULL AND DATEDIFF(DAY, dmv.SubmittedOn, GETDATE())>30 THEN 1
ELSE 0 END) AS TMFApplicableNotPublishedOver30,
SUM(
CASE WHEN (dm.TMFApplicable = 1) AND dm.[$CopiedToLinkedRoomsDate$] IS NOT NULL THEN 1
ELSE 0 END) AS TMFApplicablePublished,
SUM(
CASE WHEN ISNULL(dm.TMFApplicable, 0) = 0 AND dm.[$CopiedToLinkedRoomsDate$] IS NOT NULL THEN 1
ELSE 0 END) AS TMFNotApplicablePublished
FROM dbo.Site s
INNER JOIN dbo.SiteMetadata sm ON s.SiteId = sm.SiteId
LEFT JOIN dbo.SiteMetadata sme ON s.SiteId = sme.[$SharedWorkspaceId$]
INNER JOIN dbo.DocumentMetadata dm ON dm.SiteId = s.SiteId
INNER JOIN dbo.DocumentMetadataVirtual dmv ON dmv.TopicId = dm.TopicId AND dmv.SiteId = s.SiteId AND dmv.Deleted = 0 AND dmv.Purged = 0
WHERE s.SiteName LIKE '%Collaborate%'
GROUP BY s.SiteId, s.SiteName, sm.ProjectCode, sme.SiteId
) AS SitesData
INNER JOIN dbo.SiteSettings ss ON SitesData.SiteId = ss.SiteId]]>
		</queryString>
		<field name="SiteName" class="java.lang.String"/>
		<field name="SiteId" class="java.lang.Integer"/>
		<field name="NumberOfDocs" class="java.lang.Integer"/>
		<field name="TMFApplicable" class="java.lang.Integer"/>
		<field name="TMFApplicableNO" class="java.lang.Integer"/>
		<field name="TMFApplicableNotSet" class="java.lang.String"/>
		<field name="copiedToTMF" class="java.lang.Integer"/>
		<field name="ProjectCode" class="java.lang.Integer"/>
		<field name="TMFApplicableSet" class="java.lang.Integer"/>
		<field name="TMFApplicableNotPublished" class="java.lang.Integer"/>
		<field name="TMFApplicableNotPublishedOver30" class="java.lang.Integer"/>
		<field name="TMFApplicablePublished" class="java.lang.Integer"/>
		<field name="TMFNotApplicablePublished" class="java.lang.Integer"/>
		<field name="LinkToPPGRoom" class="java.lang.String"/>
		<field name="TMFApplicableNotSetOver30Days" class="java.lang.Integer"/>
		<sortField name="SiteName"/>
	</subDataset>

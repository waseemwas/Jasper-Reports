	<subDataset name="Dataset1" uuid="8f0b11fa-f629-4f9a-8182-89f26043026a">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="My Connection"/>
		<parameter name="SITE_ID" class="java.lang.Long" isForPrompting="false">
			<defaultValueExpression><![CDATA[24L]]></defaultValueExpression>
		</parameter>
		<parameter name="USER_ID" class="java.lang.Integer" isForPrompting="false">
			<defaultValueExpression><![CDATA[2]]></defaultValueExpression>
		</parameter>
		<queryString language="SQL">
			<![CDATA[CREATE TABLE #tmp_xx2
    (
    UserId INT,
    UserName NVARCHAR(1024),
    DocumentId  INT,
    Title NVARCHAR(1024),
    [DateTime] DATETIME,
    WorkflowId INT,
    Workflow NVARCHAR(1024),
    StageId INT,
    Stage NVARCHAR(1024),
    WorkflowStatusId INT,
    WorkflowStatus NVARCHAR(1024),
    DocumentStatus NVARCHAR(1024),
    Issues NVARCHAR(1024),
    Comments NVARCHAR(4000)
    )

 INSERT #tmp_xx2
 exec dbo.Reports_WorkflowDocumentActivity
  @SiteId = $P{SITE_ID}  , -- int
     @SQLFilter = N'', -- nvarchar(1024)
     @TimeZoneIdentifier = N'', -- nvarchar(100)
     @FilterLogic = N'', -- nvarchar(50)
     @UserId = $P{USER_ID}  , -- int
     @Top = 0, -- int
     @ExcludeMetadataUpdate = 1 -- bit

select  UserName, Stage, WorkflowStatus, count(*) as Count
from #tmp_xx2
where WorkflowStatus <>'Unclaimed'
group by UserName, Stage, WorkflowStatus

drop table #tmp_xx2]]>
		</queryString>
		<field name="Stage" class="java.lang.String"/>
		<field name="Count" class="java.lang.Integer"/>
		<field name="UserName" class="java.lang.String"/>
		<field name="WorkflowStatus" class="java.lang.String"/>
	</subDataset>
	<parameter name="USER_ID" class="java.lang.Integer" isForPrompting="false">

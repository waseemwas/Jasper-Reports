	<subDataset name="Dataset1" uuid="c6b6bdc5-058f-4661-9e9c-ac974f1d66b3">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="197"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="792"/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="WCT_RPT"/>
		<parameter name="USER_ID" class="java.lang.Integer" isForPrompting="false"/>
		<parameter name="SITE_ID" class="java.lang.Long" isForPrompting="false"/>
		<queryString language="SQL">
			<![CDATA[SELECT  dp.SiteId AS [Study Room Id],  dp.[$$RoomName$$] AS [Study Room Name],dp.TopicId AS [Document Id], dp.[$$DocumentName$$] AS [Document Name], 
dp.[$$DocumentTypeName$$] AS [Document Type], dp.DocumentStatusName AS [Document Status], dp.SubmittedOn AS [Submitted On Date], dp.[$$AddedBy$$] AS [Submitter Name], 
qc1User.FullName AS [QC1ReviewerName],  QC1ApprovedDate, QC1ClarificationDate, QC1RejectedDate, QC1RejectedIssues, QC1RejectedComments, qc2User.FullName AS [QC2ReviewerName],
QC2ApprovedDate, QC2ClarificationDate,  QC2RejectedDate,  QC2RejectedIssues, QC2RejectedComments, DATEDIFF (DAY, dp.SubmittedOn, QC1ApprovedDate) DaysSubmittedQC1Approved, 
DATEDIFF (DAY, QC1ApprovedDate, QC2ApprovedDate) DaysQC1ApprovedQC2Approved, DATEDIFF (DAY, dp.SubmittedOn, QC2ApprovedDate) DaysSubmittedQC2Approved,
QC1ReviewComments, QC2ReviewComments, dp.[$$IndexPath$$] AS [Index Path], dp.[$$CategoryName$$] AS [Category], ws.DisplayName AS [Current Status] 
FROM dbo.WorkflowLog wl  
INNER JOIN dbo.vw_DocsProfileData dp ON dp.TopicId = wl.DocumentId  
LEFT JOIN [User] qc1User ON qc1User.UserId = wl.QC1ReviewerId  
LEFT JOIN [User] qc2User ON qc2User.UserId = wl.QC2ReviewerId  
LEFT JOIN WorkflowStatus ws ON wl.CurrentStatusId = ws.WorkflowStatusId and ws.SiteId = wl.SiteId  
INNER JOIN dbo.[Site] s ON dp.SiteId = s.SiteId
INNER JOIN dbo.SiteMetadata sm ON s.SiteId = sm.SiteId
WHERE sm.[$IsClosed$] = 0 AND s.StatusId = 1 AND sm.SponsorId = 2027650]]>
		</queryString>
		<field name="Study Room Id" class="java.lang.Integer"/>
		<field name="Study Room Name" class="java.lang.String"/>
		<field name="Document Id" class="java.lang.Integer"/>
		<field name="Document Name" class="java.lang.String"/>
		<field name="Submitter Name" class="java.lang.String"/>
		<field name="Submitted On Date" class="java.sql.Timestamp"/>
		<field name="Document Status" class="java.lang.String"/>
		<field name="Document Type" class="java.lang.String"/>
		<field name="Index Path" class="java.lang.String"/>
		<field name="QC1ReviewerName" class="java.lang.String"/>
		<field name="QC1ApprovedDate" class="java.sql.Timestamp"/>
		<field name="QC1ClarificationDate" class="java.sql.Timestamp"/>
		<field name="QC1RejectedDate" class="java.sql.Timestamp"/>
		<field name="QC1ReviewComments" class="java.lang.String"/>
		<field name="QC2ReviewerName" class="java.lang.String"/>
		<field name="QC2ApprovedDate" class="java.sql.Timestamp"/>
		<field name="QC2ClarificationDate" class="java.sql.Timestamp"/>
		<field name="QC2RejectedDate" class="java.sql.Timestamp"/>
		<field name="QC2RejectedComments" class="java.lang.String"/>
	</subDataset>

		<queryString language="SQL">
			<![CDATA[SELECT 
     RoomId, 
    RoomName,
    QueryId, 
    QueryDate, 
    QueryStatus, 
    QueryType,  
    QueryClosedDate, 
    QuerySubmitter,
    ReviewerComments,
    QueryResponseDate,
    QueryResponder,
    [$$DocumentName$$],
    DocumentId, 
    DocumentSubmittedDate, 
    DocumentSubmitter, 
    DaysCreatedClosed, 
    DaysCreatedResolved, 
    DaysResolvedClosed
   FROM vw_QueryDataFull
WHERE SponsorId = 2027650]]>
		</queryString>

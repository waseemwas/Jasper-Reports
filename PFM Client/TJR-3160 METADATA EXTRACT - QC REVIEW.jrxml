	<subDataset name="Dataset1" uuid="152f81da-814c-421d-ab2f-66c48595a15c">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="sddd"/>
		<parameter name="USER_ID" class="java.lang.Integer" isForPrompting="false"/>
		<parameter name="SITE_ID" class="java.lang.Long" isForPrompting="false"/>
		<queryString language="SQL">
			<![CDATA[SELECT s.SiteId AS [Room Id], s.SiteName  AS [Room Name], dmv.TopicId AS [Document Id], dm.DocumentName AS [Document Name], wst.StageName AS [Workflow Stage], dmv.DocumentStatusName AS [Document Status] ,dmv.SubmittedOn AS [Submitted On]
FROM WorkflowLog wl 
INNER JOIN WorkflowStatus ws ON ws.SiteId = wl.SiteId AND wl.CurrentStatusId = ws.WorkflowStatusId
INNER JOIN dbo.[Site] s ON s.SiteId = ws.SiteId
INNER JOIN dbo.SiteMetadata sm ON sm.SiteId = s.SiteId
INNER JOIN dbo.DocumentMetadataVirtual dmv ON dmv.TopicId = wl.DocumentId AND dmv.Deleted = 0
INNER JOIN dbo.DocumentMetadata dm ON dm.TopicId = dmv.TopicId
INNER jOIN dbo.WorkflowStage wst ON wst.StageId = wl.CurrentStageId
WHERE ws.SystemName = 'Unclaimed' AND s.StatusId = 1 AND sm.[$IsClosed$] = 0 AND SponsorId = 2027650]]>
		</queryString>
		<field name="Room Id" class="java.lang.Integer"/>
		<field name="Room Name" class="java.lang.String"/>
		<field name="Document Id" class="java.lang.Integer"/>
		<field name="Document Name" class="java.lang.String"/>
		<field name="Workflow Stage" class="java.lang.String"/>
		<field name="Document Status" class="java.lang.String"/>
		<field name="Submitted On" class="java.sql.Timestamp"/>
		<sortField name="Room Id" order="Descending"/>
	</subDataset>

	<subDataset name="Table" uuid="2874a71c-5001-48ea-a7b6-bf262198284b">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Prod_TI_INC"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="373"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="622"/>
		<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w1" value="635"/>
		<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w2" value="354"/>
		<parameter name="USER_ID" class="java.lang.Integer" isForPrompting="false"/>
		<parameter name="SITE_ID" class="java.lang.Long" isForPrompting="false"/>
		<parameter name="USER_LIST" class="java.util.Collection" isForPrompting="false"/>
		<parameter name="DATEDIFF" class="java.lang.Integer" isForPrompting="false"/>
		<parameter name="HrefRegex" class="java.lang.String">
			<defaultValueExpression><![CDATA[".*href=\"(.*?)\".*"]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[WITH Rooms (SiteId, SiteName)
AS (
    SELECT s.SiteId, s.SiteName
    FROM [Site] s
    INNER JOIN SiteMetadata sm ON sm.SiteId = s.SiteId 
    WHERE sm.SponsorId = 2027650
    AND s.StatusId = 1 AND ISNULL(sm.[$IsClosed$], 0) = 0 
)

SELECT 
    r.SiteId AS RoomId,
    r.SiteName AS RoomName,
    ISNULL(dm.TopicId, 0) AS DocumentId, 
    dm.PublishedDate,
    CASE WHEN dm.TopicId IS NULL THEN rd.CategoryId ELSE dm.CodingTypeId END AS CodingTypeId,
    dtmv.DocumentTypeName,
    dc.CategoryName,
    dmv.DocumentStatusName,
    dmv.SubmittedOn,
    isd.[$$InstitutionName$$],
    isd.[$AutoSiteName$],
    dm.DocumentName,
    dm.[Expiration Date],
    dm.Comments,
    dm.documentonsite,
    dmv.[Document Link],
    c.Name AS Country,
    ISNULL(rd.WorkflowStatus, 'Not Required') AS CompletenessStatus,
    wl.QCRejectedIssues AS RejectedReason,
    dmv.[$$IsRejected$$],
    CASE 
        WHEN rd.RequirementId > 0 AND rd.PlaceholderTopicId > 0 THEN  'Placeholder'
        WHEN rd.RequirementId > 0 THEN  'Required'
        ELSE 'Not-Required'
    END AS [Required],
    wl.CurrentStageReviewComments,
    u.FullName AS CurrentWorkflowReviewer,
    ws.DisplayName AS CurrentWorkflowStageStatus,
    w.WorkflowName AS CurrentWorkflow,
    CASE 
        WHEN dmv.IsFinal = 1 THEN  'Final'
        WHEN dm.TopicId > 0 THEN  'Submitted'
        ELSE 'Missing'
    END AS [CompletenessStatus],
    ct.ContactTypeName + N'(' + cnt.FullName + N')' AS RelatedTo,
   dmv.[$$IsExpired$$],
    CASE  WHEN dm.TopicId IS NULL THEN rd.EventName
        ELSE em.TopicName
    END AS EventName,
    CASE  WHEN dm.TopicId IS NULL THEN rd.EventTypeName
        ELSE et.TopicName
    END AS EventTypeName,
    CASE  WHEN dm.TopicId IS NULL THEN rd.DueDate
        ELSE em.[$DueDate$]
    END AS EventDueDate,
    wl.CurrentStageReviewIssues,
    dm.AcadiaProtocol,
    w.WorkflowName,
  dtm.[$Zone$]
FROM dbo.DocumentMetadata dm
INNER JOIN dbo.DocumentMetadataVirtual dmv ON dm.TopicId = dmv.TopicId AND dmv.Deleted = 0 AND EXISTS (SELECT * FROM Rooms s WHERE s.SiteId = dm.SiteId)
LEFT jOIN WorkflowLog wl ON wl.DocumentId = dm.TopicId
LEFT JOIN Workflow w ON w.WorkflowId = wl.WorkflowId
LEFT JOIN WorkflowStageStatus ws ON ws.StageId = wl.CurrentStageId AND ws.WorkflowStatusId = wl.CurrentStatusId
LEFT JOIN [User] u ON u.UserId = wl.CurrentReviewerId
FULL JOIN (
    SELECT rd.DocumentId, rd.DocumentTypeId, rd.InvestigativeSiteId, rd.ContactId, rd.ContactTypeId, rd.Country, rd.SiteId,
        rd.CategoryId, rd.WorkflowStatus, rd.RequirementId, rd.PlaceholderTopicId, rd.EventName, rd.EventTypeName, rd.DueDate
    FROM dbo.RequiredDocuments rd
    WHERE EXISTS (SELECT * FROM Rooms s WHERE s.SiteId = rd.SiteId)
    AND rd.WorkflowStatus != 'Not Applicable'
)
rd ON rd.DocumentId = dm.TopicId 
LEFT JOIN dbo.DocumentTypeMetadataVirtual dtmv ON dtmv.TopicId = CASE WHEN dm.TopicId IS NULL THEN rd.DocumentTypeId ELSE dm.DocumentTypeId END
LEFT JOIN dbo.DocumentTypeMetadata dtm ON dtm.TopicId = dtmv.TopicId 
LEFT JOIN dbo.DocumentCategory dc ON dc.CategoryId = dtmv.DocumentCategoryId
LEFT JOIN (
    SELECT ismv.InvSiteName AS [$$InstitutionName$$], isdm.TopicId AS [$$DomainTopicId$$], ism.[$AutoSiteName$]
    FROM dbo.InvestigativeSiteMetadata ism
    INNER JOIN dbo.InvestigativeSiteMetadataVirtual ismv ON ismv.InvSiteId = ism.TopicId
    INNER JOIN dbo.InvestigativeSiteDomainMetadata isdm ON isdm.TopicId = ismv.DomainInvSiteId
    WHERE EXISTS (SELECT * FROM Rooms s WHERE s.SiteId = ism.SiteId) 
) isd ON isd.[$$DomainTopicId$$] = CASE WHEN dm.TopicId IS NULL THEN rd.InvestigativeSiteId ELSE dm.InvestigativeSiteId END
LEFT JOIN dbo.Country c ON c.Iso2 = CASE WHEN dm.TopicId IS NULL THEN rd.Country ELSE dm.[$Country$] END
LEFT JOIN dbo.[User] cnt ON cnt.UserId = rd.ContactId
LEFT JOIN dbo.ContactType ct ON ct.ContactTypeId = rd.ContactTypeId
LEFT JOIN dbo.EventMetadata em ON em.TopicId = dm.[$EventId$]
LEFT JOIN dbo.Topic et ON et.TopicId = em.[$EventTypeId$]
INNER JOIN Rooms r ON r.SiteId = ISNULL(dm.SiteId, rd.SiteId)
WHERE ISNULL(dmv.[$$IsRejected$$], 0) = 0]]>
		</queryString>

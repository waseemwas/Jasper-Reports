	<subDataset name="Dataset1" uuid="152f81da-814c-421d-ab2f-66c48595a15c">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="sddd"/>
		<parameter name="USER_ID" class="java.lang.Integer" isForPrompting="false"/>
		<parameter name="SITE_ID" class="java.lang.Long" isForPrompting="false"/>
		<queryString language="SQL">
			<![CDATA[SELECT 
    RoomId,
    RoomName, 
    QueryId, 
    QueryDate, 
    QueryStatus, 
    QueryType, 
    QueryClosedDate, 
    QuerySubmitter, 
    ReviewerComments, 
    QueryResponseDate, 
    QueryResponder, 
    [$$DocumentName$$], 
    DocumentId, 
    DocumentSubmittedDate,
    DocumentSubmitter,
    Issues,
    FirstQueryRecipients, 
    ReassignDate,
    AllQueryRecipientsNames,
    FirstQueryRecipientsNames
	History
FROM vw_QueryDataFull qdf
INNER JOIN dbo.SiteMetadata sm ON sm.SiteId = qdf.RoomId
INNER JOIN dbo.Site s ON s.SiteId = qdf.RoomId
WHERE sm.SponsorId = 2027650 AND ISNULL([$IsClosed$], 0) = 0 AND s.StatusId =1 ]]>
		</queryString>
		<field name="RoomId" class="java.lang.String"/>
		<field name="RoomName" class="java.lang.String"/>
		<field name="QueryId" class="java.lang.String"/>
		<field name="QueryDate" class="java.lang.String"/>
		<field name="QueryStatus" class="java.lang.String"/>
		<field name="QueryType" class="java.lang.String"/>
		<field name="QueryClosedDate" class="java.lang.String"/>
		<field name="QuerySubmitter" class="java.lang.String"/>
		<field name="ReviewerComments" class="java.lang.String"/>
		<field name="QueryResponseDate" class="java.lang.String"/>
		<field name="QueryResponder" class="java.lang.String"/>
		<field name="$$DocumentName$$" class="java.lang.String"/>
		<field name="DocumentId" class="java.lang.Integer"/>
		<field name="DocumentSubmittedDate" class="java.sql.Timestamp"/>
		<field name="DocumentSubmitter" class="java.lang.String"/>
		<field name="Issues" class="java.lang.String"/>
		<field name="FirstQueryRecipients" class="java.lang.String"/>
		<field name="ReassignDate" class="java.sql.Timestamp"/>
		<field name="AllQueryRecipientsNames" class="java.lang.String"/>
		<field name="History" class="java.lang.String"/>
		<sortField name="RoomId" order="Descending"/>
		<group name="QuerySubmitter">
			<groupExpression><![CDATA[$F{QuerySubmitter}]]></groupExpression>
		</group>
	</subDataset>

	<subDataset name="Dataset1" uuid="152f81da-814c-421d-ab2f-66c48595a15c">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="sddd"/>
		<parameter name="USER_ID" class="java.lang.Integer" isForPrompting="false"/>
		<parameter name="SITE_ID" class="java.lang.Long" isForPrompting="false"/>
		<parameter name="StudyName" class="java.util.Collection" nestedType="java.lang.String" isForPrompting="false"/>
		<parameter name="StartDate" class="java.sql.Date"/>
		<parameter name="EndDate" class="java.sql.Date"/>
		<parameter name="ParentIndexFilter" class="java.lang.String">
			<defaultValueExpression><![CDATA["''" + String.join("'',''", $P{StudyName}) + "''"]]></defaultValueExpression>
		</parameter>
		<queryString language="SQL">
			<![CDATA[EXEC Reports_Metadata_Dynamic2
@SiteId= $P{SITE_ID}, @UserId= $P{USER_ID},
  @SQLFilter = N'
   ([$$DocumentTypeName$$] IN (''SQV Trip Report'', ''Trip Report (SIV, IMV, COV)''))
      AND ([Document Date] BETWEEN CONVERT(DATETIME, ''$P!{StartDate}'', 120) AND CONVERT(DATETIME, ''$P!{EndDate}'', 120) OR [Document Date] is null)',    
@ListOfUsedColumns=N'[$$InvestigativeSiteName$$],[Document Id], [Document Date],[DocumentName],[VisitDate1],[$$DocumentOwnerName$$],[$EffectiveDate$],[$$SharedBy$$],[$$FirstClaimDate$$],[$SharingDate$], [$$DocumentTypeName$$],[$$ParentIndexFolder$$],[$$SecondParentIndexFolder$$], [$$IndexFolder$$], [$$Index$$]',
@ReturnedColumns=N'[$$InvestigativeSiteName$$],[Document Id], [Document Date],[DocumentName],[VisitDate1],[$$DocumentOwnerName$$],[$EffectiveDate$],[$$SharedBy$$],[$$FirstClaimDate$$],[$SharingDate$], [$$DocumentTypeName$$],[$$ParentIndexFolder$$],[$$SecondParentIndexFolder$$], [$$IndexFolder$$], [$$Index$$]']]>
		</queryString>
		<field name="$$IndexFolder$$" class="java.lang.String"/>
		<field name="Document Id" class="java.lang.Integer"/>
		<field name="Document Date" class="java.sql.Timestamp"/>
		<field name="$$DocumentOwnerName$$" class="java.lang.String"/>
		<field name="$$FirstClaimDate$$" class="java.sql.Date"/>
		<field name="$EffectiveDate$" class="java.sql.Timestamp"/>
		<field name="$SharingDate$" class="java.sql.Timestamp"/>
		<field name="$$SharedBy$$" class="java.lang.String"/>
		<field name="$$ParentIndexFolder$$" class="java.lang.String"/>
		<field name="$$InvestigativeSiteName$$" class="java.lang.String"/>
		<field name="DocumentName" class="java.lang.String"/>
		<field name="VisitDate1" class="java.sql.Timestamp"/>
	</subDataset>

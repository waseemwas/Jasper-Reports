	<subDataset name="Dataset1" uuid="152f81da-814c-421d-ab2f-66c48595a15c">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="sddd"/>
		<parameter name="USER_ID" class="java.lang.Integer" isForPrompting="false"/>
		<parameter name="SITE_ID" class="java.lang.Long" isForPrompting="false"/>
		<queryString language="SQL">
			<![CDATA[													SELECT s.SiteId, 
													s.SiteName, sm.ClientName, 
													CASE 
														WHEN s.StatusId = 2 THEN 'Inactive'
														WHEN sm.[$IsClosed$] = 1 THEN 'Closed'
														WHEN s.StatusId = 1 THEN 'Active'
														ELSE ''
													END AS StudyStatus,
													CASE WHEN ss.MdeEnabled = 1 THEN 'Yes' WHEN ss.MdeEnabled = 0 THEN 'No' END AS MdeEnabled,
													ISNULL(WFStatusUnclaimed.QC1ApprovedDocuments,0) AS QC1ApprovedDocuments,
													ISNULL(WFStatusUnclaimed.QC2ApprovedDocuments,0) AS QC2ApprovedDocuments,
													ISNULL(WFStatusUnclaimed.QC1ClarificationDocuments,0) AS QC1ClarificationDocuments,
													ISNULL(WFStatusUnclaimed.QC2ClarificationDocuments,0) AS QC2ClarificationDocuments,
													ISNULL(WFStatus.QC1Rejected,0) AS QC1Rejected,
													ISNULL(WFStatus.QC2Rejected,0) AS QC2Rejected,
													ISNULL(WFQueriedDocs.QueriedDocuments,0) AS QueriedDocuments

												FROM dbo.Site s
												INNER JOIN dbo.SiteMetadata sm ON sm.SiteId = s.SiteId
												LEFT JOIN (
													SELECT dmv.SiteId, COUNT(*) AS SubmittedCount
													FROM dbo.DocumentMetadataVirtual dmv 
													INNER JOIN Site s ON dmv.SiteId = s.SiteId
													WHERE CAST(dmv.SubmittedOn AS DATE) 
														BETWEEN DATEFROMPARTS(YEAR(DATEADD(MONTH, -1, GETDATE())), MONTH(DATEADD(MONTH, -1, GETDATE())), 1)
    AND EOMONTH(DATEADD(MONTH, -1, GETDATE()))
														AND dmv.Deleted = 0
													GROUP BY dmv.SiteId
												) dmvSubmitted ON dmvSubmitted.SiteId = s.SiteId
												LEFT JOIN (
													SELECT dmv.SiteId, COUNT(dmv.IsFinal) AS FinalCount
													FROM dbo.DocumentMetadataVirtual dmv 
													INNER JOIN Site s ON dmv.SiteId = s.SiteId
													WHERE dmv.IsFinal = 1
														AND CAST(dmv.SubmittedOn AS DATE) BETWEEN DATEFROMPARTS(YEAR(DATEADD(MONTH, -1, GETDATE())), MONTH(DATEADD(MONTH, -1, GETDATE())), 1)
    AND EOMONTH(DATEADD(MONTH, -1, GETDATE()))
														AND CAST(dmv.CurrentStageDate AS DATE) BETWEEN DATEFROMPARTS(YEAR(DATEADD(MONTH, -1, GETDATE())), MONTH(DATEADD(MONTH, -1, GETDATE())), 1)
    AND EOMONTH(DATEADD(MONTH, -1, GETDATE()))
													GROUP BY dmv.SiteId
												) dmvSubmittedPublished ON dmvSubmittedPublished.SiteId = s.SiteId
												LEFT JOIN (
													SELECT dmv.SiteId, COUNT(*) AS PublishedCount
													FROM dbo.DocumentMetadata dmv 
													INNER JOIN Site s ON dmv.SiteId = s.SiteId
													WHERE CAST(dmv.PublishedDate AS DATE) 
														BETWEEN DATEFROMPARTS(YEAR(DATEADD(MONTH, -1, GETDATE())), MONTH(DATEADD(MONTH, -1, GETDATE())), 1)
    AND EOMONTH(DATEADD(MONTH, -1, GETDATE()))
													GROUP BY dmv.SiteId
												) dmvPublished ON dmvPublished.SiteId = s.SiteId
												LEFT JOIN (
													SELECT dmv.SiteId, 
														SUM(CASE WHEN wst.StageNumber  = 1 THEN 1 ELSE 0 END ) AS QC1Rejected,
														SUM(CASE WHEN wst.StageNumber  = 2 THEN 1 ELSE 0 END ) AS QC2Rejected
													FROM DocumentMetadataVirtual dmv
													INNER JOIN dbo.WorkflowLog wl ON wl.DocumentId = dmv.TopicId
													LEFT JOIN dbo.WorkflowStageStatus ws ON ws.WorkflowStatusId = wl.CurrentStatusId AND ws.StageId =  wl.CurrentStageId 
													INNER JOIN dbo.WorkflowStage wst ON wst.StageId = wl.CurrentStageId 
													INNER JOIN Site s ON dmv.SiteId = s.SiteId
													WHERE dmv.[$$IsRejected$$] = 1 
														AND CAST(dmv.CurrentStageDate AS DATE) BETWEEN DATEFROMPARTS(YEAR(DATEADD(MONTH, -1, GETDATE())), MONTH(DATEADD(MONTH, -1, GETDATE())), 1)
    AND EOMONTH(DATEADD(MONTH, -1, GETDATE()))
													GROUP BY dmv.SiteId
												) WFStatus ON WFStatus.SiteId = s.SiteId
												LEFT JOIN (
													SELECT wh.SiteId, 
														SUM(CASE WHEN wh.[status] = 'qc1 Approved' THEN 1 ELSE 0 END ) AS QC1ApprovedDocuments,
														SUM(CASE WHEN wh.[status] = 'qc2 Approved' THEN 1 ELSE 0 END ) AS QC2ApprovedDocuments,
														SUM(CASE WHEN wh.[status] = 'qc1 Clarification' THEN 1 ELSE 0 END) AS QC1ClarificationDocuments,
														SUM(CASE WHEN wh.[status] = 'qc2 Clarification' THEN 1 ELSE 0 END) AS QC2ClarificationDocuments
													FROM (
														SELECT DISTINCT doc.SiteId, doc.TopicID, 
															CASE 
																WHEN st.TopicName IN ('Indexing Approved','Final') AND wst.StageNumber = 1 THEN 'qc1 Approved'
																WHEN st.TopicName ='Final' AND wst.StageNumber = 2 THEN 'qc2 Approved'
																WHEN st.TopicName IN ('Indexing Clarification','QC1 Clarification') AND wst.StageNumber = 1 THEN 'qc1 Clarification'
																WHEN st.TopicName IN ('Review Clarification','QC2 Clarification') AND wst.StageNumber = 2 THEN 'qc2 Clarification' 
																ELSE '' 
															END AS [status]                                                                
														FROM dbo.DocumentMetadata doc
														INNER JOIN dbo.DocumentMetadataVirtual dmv ON dmv.TopicId = doc.TopicId
														INNER JOIN dbo.WorkflowLog wl ON wl.DocumentId = doc.TopicId
														LEFT JOIN dbo.WorkflowStageStatus ws ON ws.WorkflowStatusId = wl.CurrentStatusId AND ws.StageId =  wl.CurrentStageId 
														INNER JOIN dbo.WorkflowStage wst ON wst.StageId = wl.CurrentStageId 
														LEFT JOIN dbo.Topic st ON st.TopicId = doc.DocumentStatusId
														INNER JOIN Site s ON dmv.SiteId = s.SiteId
														WHERE dmv.Deleted = 0 AND dmv.Purged = 0
														AND CAST(dmv.CurrentStageDate AS DATE) BETWEEN DATEFROMPARTS(YEAR(DATEADD(MONTH, -1, GETDATE())), MONTH(DATEADD(MONTH, -1, GETDATE())), 1)
    AND EOMONTH(DATEADD(MONTH, -1, GETDATE()))
													) wh
													GROUP BY wh.SiteId
												) WFStatusUnclaimed ON WFStatusUnclaimed.SiteId = s.SiteId
												LEFT JOIN (
													SELECT wq.SiteId,
													COUNT(wq.DocQuery) AS QueriedDocuments
													FROM (
														SELECT DISTINCT doc.SiteId, doc.TopicID,
															wq.QueryId AS DocQuery                                                                
														FROM dbo.DocumentMetadata doc
														INNER JOIN dbo.DocumentMetadataVirtual dmv ON dmv.TopicId = doc.TopicId
														INNER JOIN dbo.WorkflowLog wl ON wl.DocumentId = doc.TopicId
														LEFT JOIN dbo.WorkflowStageStatus ws ON ws.WorkflowStatusId = wl.CurrentStatusId AND ws.StageId =  wl.CurrentStageId 
														INNER JOIN dbo.WorkflowStage wst ON wst.StageId = wl.CurrentStageId 
														LEFT JOIN dbo.WorkflowQuery wq ON wq.SiteId = dmv.SiteId AND doc.TopicId = wq.DocumentId
														WHERE dmv.Deleted = 0 AND dmv.Purged = 0 
															AND wq.QueryDate BETWEEN DATEFROMPARTS(YEAR(DATEADD(MONTH, -1, GETDATE())), MONTH(DATEADD(MONTH, -1, GETDATE())), 1) AND EOMONTH(DATEADD(MONTH, -1, GETDATE()))
															AND wq.QueryType = 'Workflow'
													) wq
													GROUP BY wq.SiteId
												) WFQueriedDocs ON WFQueriedDocs.SiteId = s.SiteId
												INNER JOIN SiteCategory sc ON sc.SiteCategoryId = sm.SiteCategoryId
												LEFT JOIN SiteSettings ss ON ss.SiteId = sm.SiteId

												WHERE s.SiteTypeId = 1 AND s.StatusId = 1
												ORDER BY s.SiteName]]>
		</queryString>
		<field name="SiteId" class="java.lang.Integer"/>
		<field name="SiteName" class="java.lang.String"/>
		<field name="ClientName" class="java.lang.String"/>
		<field name="StudyStatus" class="java.lang.String"/>
		<field name="MdeEnabled" class="java.lang.String"/>
		<field name="QC1ApprovedDocuments" class="java.lang.Integer"/>
		<field name="QC2ApprovedDocuments" class="java.lang.Integer"/>
		<field name="QC1ClarificationDocuments" class="java.lang.Integer"/>
		<field name="QC2ClarificationDocuments" class="java.lang.Integer"/>
		<field name="QC1Rejected" class="java.lang.Integer"/>
		<field name="QC2Rejected" class="java.lang.Integer"/>
		<field name="QueriedDocuments" class="java.lang.Integer"/>
	</subDataset>

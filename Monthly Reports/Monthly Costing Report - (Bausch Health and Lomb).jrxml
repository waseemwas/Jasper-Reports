	<subDataset name="Dataset1" uuid="45f2dc73-9355-48b6-9af7-2a3b14658908">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="1"/>
		<parameter name="USER_ID" class="java.lang.Integer" isForPrompting="false">
			<parameterDescription><![CDATA[]]></parameterDescription>
			<defaultValueExpression><![CDATA[2]]></defaultValueExpression>
		</parameter>
		<parameter name="SITE_ID" class="java.lang.Long" isForPrompting="false">
			<defaultValueExpression><![CDATA[222L]]></defaultValueExpression>
		</parameter>
		<queryString language="SQL">
			<![CDATA[WITH SiteInfo AS (
    SELECT
        s.SiteId AS RoomId,
        s.SiteName AS RoomName,
        CASE 
            WHEN s.StatusId = 1 THEN 'Published'
            WHEN s.StatusId = 2 THEN 'Unpublished'
        END AS RoomStatus,
        s.CreatedDate AS RoomCreationDate,
        ProjectCode,
        sm.ProtocolNumber,
        '' AS ProjectManager,
        tr.TopicName AS Region,
        ClientName,
        ' ' AS ClientType,
        ' ' AS BillingJobNumber,
        IndexPath AS SiteIndexPath,
        CASE 
            WHEN COUNT(dmv.TopicId) > 1 THEN 'Y' 
            ELSE 'N' 
        END AS DocumentUploadedinRoom,
        CASE 
            WHEN COUNT(dm.TopicId) > 1 
                 AND COUNT(dm.DocumentTypeId) > 1 
            THEN 'Y' 
            ELSE 'N' 
        END AS DocumentEverBeenCodedinRoom,
        CASE 
            WHEN COUNT(dm.TopicId) > 1 
                 AND COUNT(dm.DocumentTypeId) > 1
                 AND SUM(
                        CASE 
                            WHEN dmv.SubmittedOn >= DATEADD(MONTH, DATEDIFF(MONTH, 0, GETDATE()) - 1, 0)
                             AND dmv.SubmittedOn <  DATEADD(MONTH, DATEDIFF(MONTH, 0, GETDATE()), 0)
                            THEN 1
                            ELSE 0
                        END
                    ) > 0
            THEN 'Y' 
            ELSE 'N' 
        END AS DocumentEverBeenCodedinRoomByMonth,
        CASE 
            WHEN ss.MdeEnabled = 1 THEN 'Y'
            WHEN ss.MdeEnabled = 0 THEN 'N'
        END AS MdeEnabled
    FROM SiteMetadata sm
    INNER JOIN Site s
        ON s.SiteId = sm.SiteId
    INNER JOIN SiteCategory sc
        ON sc.SiteCategoryId = sm.SiteCategoryId
    LEFT JOIN DocumentMetadataVirtual dmv
        ON dmv.SiteId = s.SiteId
    LEFT JOIN DocumentMetadata dm
        ON dm.TopicId = dmv.TopicId
    LEFT JOIN Topic tr
        ON tr.TopicId = sm.Region
       AND tr.TopicType = 'Region'
    LEFT JOIN SiteSettings ss
        ON ss.SiteId = sm.SiteId
    GROUP BY
        s.SiteId,
        s.SiteName,
        s.StatusId,
        s.CreatedDate,
        ProjectCode,
        sm.ProtocolNumber,
        tr.TopicName,
        ClientName,
        IndexPath,
        ss.MdeEnabled
)
SELECT
    (SELECT MAX(CreatedDate) FROM RefreshingLog) AS [Data Refresh Time],
    si.RoomId,
    si.RoomName,
    si.RoomStatus,
    si.RoomCreationDate,
    si.ProjectCode,
    si.ProtocolNumber,
    si.ProjectManager,
    si.Region,
    si.ClientName,
    si.ClientType,
    si.BillingJobNumber,
    si.SiteIndexPath,
    si.DocumentUploadedinRoom,
    si.DocumentEverBeenCodedinRoom,
    si.DocumentEverBeenCodedinRoomByMonth,
    ism.[$AutoSiteName$],
    ismv.InvSiteName,
    ismv.CreatedDate,
    ism.SiteActivationDate,
    si.MdeEnabled,
    CASE 
        WHEN COUNT(dm.TopicId) > 1 THEN 'Y'
        ELSE 'N'
    END AS [Documents Coded for Sites],
    CASE 
        WHEN COUNT(dm.TopicId) > 1
             AND SUM(
                    CASE 
                        WHEN dmv.SubmittedOn >= DATEADD(MONTH, DATEDIFF(MONTH, 0, GETDATE()) - 1, 0)
                         AND dmv.SubmittedOn <  DATEADD(MONTH, DATEDIFF(MONTH, 0, GETDATE()), 0)
                        THEN 1
                        ELSE 0
                    END
                 ) > 0
        THEN 'Y'
        ELSE 'N'
    END AS [Document Coded per Sites in Month]
FROM SiteInfo si
LEFT JOIN InvestigativeSiteMetadata ism
    ON ism.SiteId = si.RoomId
LEFT JOIN InvestigativeSiteMetadataVirtual ismv
    ON ismv.InvSiteId = ism.TopicId
LEFT JOIN DocumentMetadata dm
    ON dm.InvestigativeSiteId = ismv.DomainInvSiteId
LEFT JOIN DocumentMetadataVirtual dmv
    ON dmv.TopicId = dm.TopicId
LEFT JOIN Folder f
    ON f.FolderId = dmv.FolderId
WHERE si.RoomCreationDate < DATEADD(MONTH, DATEDIFF(MONTH, 0, GETDATE()), 0)
GROUP BY
    si.RoomId,
    si.RoomName,
    si.RoomStatus,
    si.RoomCreationDate,
    si.ProjectCode,
    si.ProtocolNumber,
    si.ProjectManager,
    si.Region,
    si.ClientName,
    si.ClientType,
    si.BillingJobNumber,
    si.SiteIndexPath,
    si.DocumentUploadedinRoom,
    si.DocumentEverBeenCodedinRoom,
    si.DocumentEverBeenCodedinRoomByMonth,
    ism.[$AutoSiteName$],
    ismv.InvSiteName,
    ismv.CreatedDate,
    ism.SiteActivationDate,
    si.MdeEnabled
ORDER BY
    si.RoomId,
    ism.[$AutoSiteName$]]]>
		</queryString>
		<field name="RoomId" class="java.lang.Integer"/>
		<field name="RoomName" class="java.lang.String"/>
		<field name="RoomStatus" class="java.lang.String"/>
		<field name="RoomCreationDate" class="java.sql.Timestamp"/>
		<field name="ProjectCode" class="java.lang.String"/>
		<field name="ProtocolNumber" class="java.lang.String"/>
		<field name="ProjectManager" class="java.lang.String"/>
		<field name="Region" class="java.lang.String"/>
		<field name="ClientName" class="java.lang.String"/>
		<field name="ClientType" class="java.lang.String"/>
		<field name="BillingJobNumber" class="java.lang.String"/>
		<field name="SiteIndexPath" class="java.lang.String"/>
		<field name="DocumentUploadedinRoom" class="java.lang.String"/>
		<field name="DocumentEverBeenCodedinRoom" class="java.lang.String"/>
		<field name="DocumentEverBeenCodedinRoomByMonth" class="java.lang.String"/>
		<field name="MdeEnabled" class="java.lang.String"/>
		<field name="$AutoSiteName$" class="java.lang.String"/>
		<field name="InvSiteName" class="java.lang.String"/>
		<field name="CreatedDate" class="java.sql.Timestamp"/>
		<field name="SiteActivationDate" class="java.sql.Timestamp"/>
		<field name="Documents Coded for Sites" class="java.lang.String"/>
		<field name="Document Coded per Sites in Month" class="java.lang.String"/>
	</subDataset>

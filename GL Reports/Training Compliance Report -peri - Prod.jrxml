			<property name="com.jaspersoft.studio.field.tree.path" value="mdl_course"/>
		</field>
		<field name="Assigned Course Name" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.label" value="Course name"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="mdl_course"/>
		</field>
		<field name="Assigned Course Version" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.label" value="Course Version"/>
		</field>
		<field name="Course Enrollment Date" class="java.sql.Timestamp">
			<property name="com.jaspersoft.studio.field.label" value="Course Completed"/>
		</field>
		<field name="Course Completion Date" class="java.sql.Timestamp">
			<property name="com.jaspersoft.studio.field.label" value="Course Completion Date"/>
		</field>
		<field name="Training Group Name" class="java.lang.String"/>
		<field name="Training Due Date" class="java.sql.Date"/>
		<field name="Days Overdue" class="java.lang.String"/>
		<field name="Is training overdue" class="java.lang.String"/>
	</subDataset>

	<subDataset name="tableDataset" uuid="67410190-212e-4eb3-97a7-cf43c98690d4">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="GL2_Ideus "/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<parameter name="Company" class="java.lang.Integer"/>
		<queryString language="SQL">
			<![CDATA[SELECT DISTINCT
    ccat.name AS 'Catalog Name',
    u.firstname AS 'Learner First Name',
    u.lastname AS 'Learner Last Name',
	u.email AS 'Learner Email',
    c.fullname AS 'Assigned Course Name',
	CASE
        WHEN c.version LIKE '%.%' THEN c.version
        ELSE CONCAT(c.version, '.0')
    END AS 'Assigned Course Version',
    CASE
        WHEN
            ue.timecreated > 0
        THEN
            STR_TO_DATE(FROM_UNIXTIME(ue.timecreated, '%Y-%m-%d %H:%i:%s'),'%Y-%m-%d')
        ELSE ''
    END AS `Course Enrollment Date`,
        CASE
        WHEN
            cc.timecompleted > 0
        THEN
            STR_TO_DATE(FROM_UNIXTIME(cc.timecompleted, '%Y-%m-%d'),
                    '%Y-%m-%d')
        ELSE ''
    END AS `Course Completion Date`,
	GROUP_CONCAT(DISTINCT d.name SEPARATOR ', ') AS 'Training Group Name',
    CASE
        WHEN
            ue.indmaxdate > 0
        THEN
            STR_TO_DATE(FROM_UNIXTIME(ue.indmaxdate, '%Y-%m-%d %H:%i:%s'),'%Y-%m-%d')
        WHEN
            ue.indmaxdays > 0
        THEN
        STR_TO_DATE(FROM_UNIXTIME(ue.timecreated + (ue.indmaxdays * 86400), '%Y-%m-%d %H:%i:%s'),'%Y-%m-%d')
        WHEN
            c.duecondition = 2 AND c.maxdays > 0
        THEN
        STR_TO_DATE(FROM_UNIXTIME(ue.timecreated + (c.maxdays * 86400), '%Y-%m-%d %H:%i:%s'),'%Y-%m-%d')
        WHEN
            c.duecondition = 1 AND c.maxdate > 0
        THEN
        STR_TO_DATE(FROM_UNIXTIME(c.maxdate, '%Y-%m-%d %H:%i:%s'),'%Y-%m-%d')
        ELSE NULL
    END AS `Training Due Date`,
    
        CASE
        WHEN
			cc.timecompleted = 0 OR cc.timecompleted IS NULL
		THEN
			CASE
				WHEN
					ue.indmaxdays > 0
						AND UNIX_TIMESTAMP(UTC_TIMESTAMP()) > (ue.timecreated + ((ue.indmaxdays + 1) * 86400))
				THEN
					FLOOR((UNIX_TIMESTAMP(UTC_TIMESTAMP()) - (ue.timecreated + (ue.indmaxdays * 86400))) / 86400)
				WHEN
					ue.indmaxdate > 0
						AND UNIX_TIMESTAMP(UTC_TIMESTAMP()) > (ue.indmaxdate + 86400)
				THEN
					FLOOR((UNIX_TIMESTAMP(UTC_TIMESTAMP()) - ue.indmaxdate) / 86400)
				WHEN
					c.duecondition = 2 AND c.maxdays > 0
						AND UNIX_TIMESTAMP(UTC_TIMESTAMP()) > (ue.timecreated + ((c.maxdays + 1) * 86400))
				THEN
					FLOOR((UNIX_TIMESTAMP(UTC_TIMESTAMP()) - (ue.timecreated + (c.maxdays * 86400))) / 86400)
				WHEN
					c.duecondition = 1 AND c.maxdate > 0 AND ue.indmaxdays = 0
						AND UNIX_TIMESTAMP(UTC_TIMESTAMP()) > (c.maxdate + 86400)
				THEN
					FLOOR((UNIX_TIMESTAMP(UTC_TIMESTAMP()) - c.maxdate) / 86400)
				ELSE ''
			END
		ELSE ''
    END AS `Days Overdue`,

        CASE
        WHEN
			cc.timecompleted = 0 OR cc.timecompleted IS NULL
		THEN
			CASE
				WHEN
					ue.indmaxdays > 0
						AND UNIX_TIMESTAMP(UTC_TIMESTAMP()) > (ue.timecreated + ((ue.indmaxdays + 1) * 86400))
				THEN
					'Yes'
				WHEN
					ue.indmaxdate > 0
						AND UNIX_TIMESTAMP(UTC_TIMESTAMP()) > (ue.indmaxdate + 86400)
				THEN
					'Yes'
				WHEN
					c.duecondition = 2 AND c.maxdays > 0
						AND UNIX_TIMESTAMP(UTC_TIMESTAMP()) > (ue.timecreated + ((c.maxdays + 1) * 86400))
				THEN
					'Yes'
				WHEN
					c.duecondition = 1 AND c.maxdate > 0 AND ue.indmaxdays = 0
						AND UNIX_TIMESTAMP(UTC_TIMESTAMP()) > (c.maxdate + 86400)
				THEN
					'Yes'
				ELSE ''
			END
		ELSE ''
	 END AS `Is training overdue?`
FROM
    mdl_user_enrolments ue
        INNER JOIN
    mdl_user u ON ue.userid = u.id
        LEFT JOIN
    mdl_user_manager_mapping umm ON umm.userid = u.id
        LEFT JOIN
    mdl_user um ON um.id = umm.manager
       INNER JOIN
    mdl_company_users_data cud ON cud.userid = u.id
        INNER JOIN
    mdl_company_users cu ON cu.userid = u.id
        INNER JOIN
    mdl_enrol e ON ue.enrolid = e.id
        INNER JOIN
    mdl_course c ON c.id = e.courseid
        INNER JOIN
    mdl_context ctx ON ctx.instanceid = c.id
        INNER JOIN
    mdl_role_assignments ra ON ra.userid = ue.userid
        AND ra.contextid = ctx.id
        INNER JOIN
    mdl_course_completions cc ON cc.course = c.id AND cc.userid = u.id
        LEFT JOIN
    mdl_company_course coc ON coc.companyid = cud.companyid AND coc.courseid = c.id
        LEFT JOIN
    mdl_department d ON d.id = coc.departmentid
        AND d.id = cu.departmentid
        LEFT JOIN
    mdl_department_room dr ON dr.departmentid = d.id
		LEFT JOIN 
   mdl_course_course_catalog ccc ON ccc.courseid = c.id
		LEFT JOIN 
   mdl_course_catalog ccat ON ccat.id = ccc.catalogid
WHERE
    c.id > 0  AND c.deleted = 0 AND c.visible = 1
    AND cud.suspended = 0 AND cud.suspendtraining = 0
        AND cud.companyid = 22
        AND c.lpcourse != 1
        AND c.duecondition > 0
        AND ((c.duecondition = 1 AND ((ue.indmaxdate > 0 AND ue.indmaxdate > (UNIX_TIMESTAMP(UTC_TIMESTAMP()) - 30*24*60*60) AND ue.indmaxdate < UNIX_TIMESTAMP(UTC_TIMESTAMP())) OR ((ue.indmaxdate = 0 OR ue.indmaxdate IS NULL) AND (ue.indmaxdays = 0 OR ue.indmaxdays IS NULL) AND c.maxdate > 0 AND c.maxdate > (UNIX_TIMESTAMP(UTC_TIMESTAMP()) - 30*24*60*60)  AND c.maxdate < UNIX_TIMESTAMP(UTC_TIMESTAMP())) OR (ue.indmaxdays>0 AND (ue.timecreated + (ue.indmaxdays * 86400)) > (UNIX_TIMESTAMP(UTC_TIMESTAMP()) - 30*24*60*60) AND (ue.timecreated + (ue.indmaxdays * 86400)) < UNIX_TIMESTAMP(UTC_TIMESTAMP())))  )
        OR (c.duecondition = 2 AND ((ue.indmaxdays > 0 AND (ue.timecreated + (ue.indmaxdays * 86400)) > (UNIX_TIMESTAMP(UTC_TIMESTAMP()) - 30*24*60*60) AND (ue.timecreated + (ue.indmaxdays * 86400)) < UNIX_TIMESTAMP(UTC_TIMESTAMP())) OR (ue.indmaxdays = 0 AND c.maxdays > 0 AND (ue.timecreated + (c.maxdays * 86400)) > (UNIX_TIMESTAMP(UTC_TIMESTAMP()) - 30*24*60*60) AND (ue.timecreated + (c.maxdays * 86400)) < UNIX_TIMESTAMP(UTC_TIMESTAMP())) ) ) )
GROUP BY c.id, u.id
ORDER BY `Training Due Date` DESC]]>
		</queryString>
		<field name="Catalog Name" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.label" value="User ID"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="mdl_user"/>
		</field>
		<field name="Learner First Name" class="java.lang.String">

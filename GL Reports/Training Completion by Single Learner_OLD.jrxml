			<property name="com.jaspersoft.studio.field.tree.path" value="mdl_course"/>
		</field>
		<field name="Course Assigned Date " class="java.sql.Timestamp"/>
		<field name="Course Completion Date" class="java.sql.Timestamp"/>
		<field name="eSign" class="java.lang.String"/>
	</subDataset>

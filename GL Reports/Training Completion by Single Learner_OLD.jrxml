	<subDataset name="tableDataset" uuid="67410190-212e-4eb3-97a7-cf43c98690d4">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="GL2_Ideus "/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<parameter name="Company" class="java.lang.Integer"/>
		<parameter name="UserName" class="java.util.Collection"/>
		<parameter name="SqlFilter" class="java.lang.String">
			<defaultValueExpression><![CDATA["and u.id IN (" + String.join(",", $P{UserName}) + ")"]]></defaultValueExpression>
		</parameter>
		<queryString language="SQL">
			<![CDATA[SELECT 
    u.id AS 'User ID',
    u.firstname AS 'First Name',
    u.lastname AS 'Last Name',
    CASE
        WHEN
            crc.duedate > 0
        THEN
            STR_TO_DATE(FROM_UNIXTIME(crc.duedate, '%Y-%m-%d'),
                    '%Y-%m-%d')
        ELSE NULL
    END AS 'Course Due Date',
    c.fullname AS 'Course Name',
    GROUP_CONCAT(DISTINCT d.name
        SEPARATOR ',') AS 'Training Groups',
    crc.coursestatus AS 'Course Status',
    CASE
        WHEN
            ue.timecreated > 0
        THEN
            STR_TO_DATE(FROM_UNIXTIME(ue.timecreated, '%Y-%m-%d'),
                    '%Y-%m-%d')
        ELSE NULL
    END AS 'Course Assigned Date',
    CASE
        WHEN
            crc.timecompleted > 0
        THEN
            STR_TO_DATE(FROM_UNIXTIME(crc.timecompleted, '%Y-%m-%d'),
                    '%Y-%m-%d')
        ELSE NULL
    END AS 'Course Completion Date',
    CASE
        WHEN
            (c.esignature = 0
                OR (SELECT 
                    ns.value
                FROM
                    mdl_multi_notification_settings ns
                WHERE
                    ns.companyid = 23
                        AND ns.name = 'multi_module_esignature') = 0)
        THEN
            'N/A'
        WHEN
            (cuc.esign IS NOT NULL OR cuc.esign > 0)
                AND el.signedon IS NOT NULL
        THEN
            FROM_UNIXTIME(el.signedon, '%d %M %Y %H:%i:%s')
        ELSE 'Not Completed'
    END AS 'eSign'
FROM
    mdl_compliance_report_crondata crc
        JOIN
    mdl_course c ON c.id = crc.courseid
        JOIN
    mdl_enrol e ON e.courseid = crc.courseid
        JOIN
    mdl_user_enrolments ue ON ue.enrolid = e.id
        AND ue.userid = crc.userid
        JOIN
    mdl_user u ON u.id = crc.userid
        JOIN
    mdl_company_users cu ON cu.userid = crc.userid
        AND cu.companyid = crc.companyid
        LEFT JOIN
    mdl_course_completions cuc ON cuc.userid = crc.userid
        AND cuc.course = crc.courseid
        LEFT JOIN
    mdl_department d ON crc.departmentid = d.id
        AND d.company = crc.companyid
        LEFT JOIN
    mdl_department_room dr ON crc.companyid = dr.companyid
        AND crc.departmentid = dr.departmentid
        LEFT JOIN
    mdl_company_course cc ON cc.departmentid = crc.departmentid
        AND cc.courseid = crc.courseid
        AND cc.companyid = crc.companyid
        LEFT JOIN
    mdl_user ad ON ad.id = crc.adminid
        JOIN
    mdl_course_user_mapping cum ON cum.companyid = crc.companyid
        AND cum.userid = crc.userid
        AND cum.courseid = crc.courseid
        AND cum.groupmax = 1
        LEFT JOIN
    mdl_esignature_log el ON cuc.esign = el.id
WHERE
    (e.enrol LIKE 'manual'
        OR e.enrol LIKE 'self')
        AND ue.status = 0
        AND (crc.roles = 5 OR crc.roles LIKE '5,%'
        OR crc.roles LIKE '%,5,%'
        OR crc.roles LIKE '%,5')
        AND crc.companyid = 31
        AND c.lpcourse != 1
        $P!{SqlFilter}
GROUP BY crc.companyid , crc.userid , crc.courseid
ORDER BY crc.id DESC]]>
		</queryString>
		<field name="First Name" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.label" value="First Name"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="mdl_user"/>
